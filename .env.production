# Deliberately empty.
#
# In production vercel.json rewrites /api/* and /health to the backend, so the
# browser only ever talks to its own origin: no CORS, no preflight, no cookie
# domain problems. Setting a value here would send requests cross-origin again.
VITE_API_URL=

# --- Cloudinary (admin panel file uploads) -----------------------------------
# Set these in Vercel → Settings → Environment Variables instead of committing
# them, so the cloud can be swapped without a code change. Values here are only
# the fallback for a local `npm run build`.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
