# Empty on purpose: the Vite dev server proxies /api and /health to the backend
# (see vite.config.js), so requests stay same-origin exactly as they do in
# production behind vercel.json. Nothing here needs to change per machine.
VITE_API_URL=

# Where that proxy forwards to. 8001 rather than 8000 because the Yarrow
# gateway already occupies 8000 on this machine.
VITE_DEV_API_TARGET=http://localhost:8001

# --- Cloudinary (admin panel file uploads) -----------------------------------
# Both values are public by design: unsigned uploads identify the target cloud
# and preset, they do not authorise anything a stranger could not also request.
# Restrict the preset itself in the Cloudinary dashboard (folder, formats, max
# size) — that is what actually limits abuse.
#
# Fill these in from Cloudinary → Settings → Upload → Upload presets (unsigned).
# Leave them empty and the admin panel still works; only file upload is
# disabled, and URLs can be pasted by hand.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
